APP_NAME=AegisDesk AI
APP_ENV=development
API_PREFIX=/api/v1
JWT_SECRET_KEY=aegisdesk-ai-local-dev-secret-change-me-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
#mysql配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER_NAME=root
MYSQL_USER_PASSWORD=password
MYSQL_DB_NAME=aegisdeskAI

#qdrant向量数据库
QDRANT_URL=https://bfc25f92-4703-425e-9fb5-089968a9e2bf.us-west-2-0.aws.cloud.qdrant.io
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

#大模型配置
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=qwen-plus

#嵌入模型配置
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-with-your-embedding-api-key
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BATCH_SIZE=10
#rerank模型配置
RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_API_KEY=replace-with-your-bailian-api-key
RERANK_MODEL=gte-rerank-v2

#每个用户每日提问次数上限，默认 100，设置为 0 表示不限制
DAILY_QUESTION_LIMIT=100
#单次提问最大长度，默认 500
MAX_QUESTION_LENGTH=500
#最终给 LLM 使用的知识片段数量
RAG_TOP_K=6
#问题改写 query 数
RAG_REWRITE_QUERY_COUNT=3
#每个 query 召回数量
RAG_RECALL_PER_QUERY=10
#RRF 融合后保留候选数量
RAG_RRF_TOP_K=20
RAG_RRF_K=60
#Rerank 相关性阈值
RAG_SCORE_THRESHOLD=0.5
#命中 chunk 后额外携带前后相邻 chunk 数量
RAG_ADJACENT_CHUNK_WINDOW=1
